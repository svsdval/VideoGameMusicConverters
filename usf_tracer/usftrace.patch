diff --git a/rsp_hle/trace.c b/rsp_hle/trace.c
new file mode 100644
index 0000000..f7f17be
--- /dev/null
+++ b/rsp_hle/trace.c
@@ -0,0 +1,27 @@
+#include "trace.h"
+uint32_t usf_cur_table;
+int usf_adpcm_seen;
+int usf_adpcm_init;
+uint16_t usf_last_load_in;
+unsigned usf_last_load_cnt;
+FILE *usf_trace_f, *usf_trace_pcm;
+static struct usf_voice voices[4096];
+static struct usf_cov covs[65536];
+struct usf_voice *usf_voice_get(uint32_t addr)
+{
+    unsigned i = (addr * 2654435761u) >> 20 & 4095;
+    for (;;) {
+        if (!voices[i].used) { voices[i].used = 1; voices[i].addr = addr; return &voices[i]; }
+        if (voices[i].addr == addr) return &voices[i];
+        i = (i + 1) & 4095;
+    }
+}
+struct usf_cov *usf_cov_get(unsigned hash)
+{
+    unsigned i = (hash * 2654435761u) >> 16 & 65535;
+    for (;;) {
+        if (!covs[i].used) { covs[i].used = 1; covs[i].hash = hash; return &covs[i]; }
+        if (covs[i].hash == hash) return &covs[i];
+        i = (i + 1) & 65535;
+    }
+}
diff --git a/rsp_hle/trace.h b/rsp_hle/trace.h
new file mode 100644
index 0000000..a783b22
--- /dev/null
+++ b/rsp_hle/trace.h
@@ -0,0 +1,15 @@
+#ifndef USF_TRACE_H
+#define USF_TRACE_H
+#include <stdio.h>
+#include <stdint.h>
+extern uint32_t usf_cur_table;
+extern int usf_adpcm_seen;
+extern int usf_adpcm_init;
+extern uint16_t usf_last_load_in;
+extern unsigned usf_last_load_cnt;
+extern FILE *usf_trace_f, *usf_trace_pcm;
+struct usf_voice { uint32_t addr; long cum; unsigned hash; int has; int used; };
+struct usf_cov { unsigned hash; long len; int used; };
+struct usf_voice *usf_voice_get(uint32_t addr);
+struct usf_cov *usf_cov_get(unsigned hash);
+#endif
diff --git a/test/usftrace.c b/test/usftrace.c
new file mode 100644
index 0000000..62c0b0e
--- /dev/null
+++ b/test/usftrace.c
@@ -0,0 +1,44 @@
+#include <stdlib.h>
+#include <string.h>
+#include "../usf/usf.h"
+#include "../rsp_hle/trace.h"
+#include <psflib.h>
+unsigned char * state = 0;
+unsigned int enable_compare = 0, enable_fifo_full = 0;
+static void * f_open(void * c, const char * p){ return fopen(p,"rb"); }
+static size_t f_read(void *p,size_t s,size_t n,void*f){ return fread(p,s,n,(FILE*)f); }
+static int f_seek(void*f,int64_t o,int w){ return fseek((FILE*)f,o,w); }
+static int f_close(void*f){ return fclose((FILE*)f); }
+static long f_tell(void*f){ return ftell((FILE*)f); }
+static psf_file_callbacks cb = { "\\/:", NULL, f_open, f_read, f_seek, f_close, f_tell };
+static int loader(void * c, const uint8_t * exe, size_t es, const uint8_t * r, size_t rs){ if (exe && es>0) return -1; return usf_upload_section(state, r, rs); }
+static int info(void * c, const char * n, const char * v){
+    if (!strcasecmp(n,"_enablecompare") && *v) enable_compare = 1;
+    if (!strcasecmp(n,"_enablefifofull") && *v) enable_fifo_full = 1;
+    return 0; }
+static void msg(void*u,const char*m){ }
+int main(int argc, char **argv)
+{
+    /* usftrace in.miniusf out_prefix seconds [wav.raw] */
+    if (argc < 4) { fprintf(stderr,"usage: usftrace in.miniusf out_prefix seconds [out.raw]\n"); return 2; }
+    char p[4096]; int16_t buf[2048]; int32_t rate = 0;
+    state = malloc(usf_get_state_size()); usf_clear(state);
+    if (psf_load(argv[1], &cb, 0x21, loader, 0, info, 0, 1, msg, 0) <= 0) return 1;
+    usf_set_compare(state, enable_compare); usf_set_fifo_full(state, enable_fifo_full);
+    usf_set_hle_audio(state, 1);
+    snprintf(p,sizeof p,"%s.trace",argv[2]); usf_trace_f = fopen(p,"w");
+    snprintf(p,sizeof p,"%s.pcm",argv[2]); usf_trace_pcm = fopen(p,"wb");
+    FILE *raw = argc > 4 ? fopen(argv[4],"wb") : NULL;
+    long total = (long)(atof(argv[3]) * 44100);
+    usf_render(state, NULL, 0, &rate);
+    fprintf(usf_trace_f, "# rate %d\n", (int)rate);
+    while (total > 0) {
+        int n = total > 1024 ? 1024 : (int)total;
+        usf_render_resampled(state, buf, n, 44100);
+        if (raw) fwrite(buf, n, 4, raw);
+        total -= n;
+    }
+    usf_shutdown(state);
+    fclose(usf_trace_f); fclose(usf_trace_pcm); if (raw) fclose(raw);
+    return 0;
+}
