     size_t samplesTodo;
     size_t i;
     size /= 4;
+    state->vi_without_audio = 0;
 
     samplesTodo = size;
     if (samplesTodo > state->sample_buffer_count)
diff --git a/usf/usf_internal.h b/usf/usf_internal.h
index b5f51b4..fc85e42 100644
--- a/usf/usf_internal.h
+++ b/usf/usf_internal.h
@@ -267,6 +267,8 @@ struct usf_state
     // SampleRate is usually guaranteed to stay the same for the duration
     // of a given track, and depends on the game.
     int32_t SampleRate;
+    // кадры VI подряд без аудио от игры (см. vi_vertical_interrupt_event)
+    unsigned int vi_without_audio;
     // Audio is rendered in whole Audio Interface DMA transfers, which are
     // then copied directly to the caller's buffer. Any left over samples
