diff --git a/vi/vi_controller.c b/vi/vi_controller.c
index 1b94400..15de0c5 100644
--- a/vi/vi_controller.c
+++ b/vi/vi_controller.c
@@ -121,6 +121,21 @@ void vi_vertical_interrupt_event(struct vi_controller* vi)
     vi->next_vi = state->g_cp0_regs[CP0_COUNT_REG] + vi->delay;
     add_interupt_event_count(state, VI_INT, vi->next_vi);
 
+    /* Игра перестала выдавать звук (SFX закончился, пауза и т.п.): без AI-данных
+       usf_render() не вернулся бы никогда. Через ~1 с тишины досыпаем нули на каждый кадр VI. */
+    if (++state->vi_without_audio > 60 && state->SampleRate > 0)
+    {
+        static const int16_t zeros[2 * 4096];
+        size_t n = (size_t)((uint64_t)state->SampleRate * vi->delay / 93750000u);
+        if (n > 4096) n = 4096;
+        if (n)
+        {
+            unsigned int keep = state->vi_without_audio;
+            usf_push_audio_samples(state, zeros, n * 4);
+            state->vi_without_audio = keep;
+        }
+    }
+
     /* trigger interrupt */
     raise_rcp_interrupt(vi->r4300, MI_INTR_VI);
 }
